MENO_ENV=development
MENO_DATABASE_URL=sqlite:///./meno.db
MENO_VECTOR_MODE=memory
MENO_QDRANT_URL=http://127.0.0.1:6333
MENO_QDRANT_COLLECTION=meno_claims_gemini_768_v1
MENO_EMBEDDING_PROVIDER=google
MENO_EMBEDDING_MODEL=gemini-embedding-001
MENO_EMBEDDING_DIMENSION=768
MENO_EMBEDDING_PROJECTION_VERSION=gemini-embedding-001-768-v1
MENO_GOOGLE_CREDENTIALS_FILE=/run/secrets/meno-google-embedding
MENO_GOOGLE_TIMEOUT_SECONDS=15
MENO_GOOGLE_BATCH_SIZE=32
MENO_GOOGLE_MAX_RETRIES=4
MENO_VECTOR_UPSERT_BATCH_SIZE=128
MENO_POLICY_VERSION=meno-policy-1.0.0
MENO_WORKER_POLL_SECONDS=0.2
MENO_API_HOST=127.0.0.1
MENO_API_PORT=8765
MENO_API_TOKEN=replace-with-a-long-random-token
