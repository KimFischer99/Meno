# Meno production environment — single small host profile
#
# Copy to a file outside the repository (e.g. /etc/meno.env), chmod 600, then
# replace every `replace-with-...` value. This file is committed and must never
# contain a real credential.
#
# See deploy/README.md for the memory budget and install steps.

# ---------------------------------------------------------------- core profile
MENO_ENV=production

# Absolute path, four slashes after `sqlite:`. Must not be under /tmp, /var/tmp,
# or /dev/shm: the canonical store has to survive a reboot to stay replayable.
MENO_DATABASE_URL=sqlite:////var/lib/meno/meno.db

# In-process vectors instead of Qdrant. Bounded by MENO_VECTOR_MAX_RESIDENT below.
MENO_VECTOR_MODE=memory

# ------------------------------------------------------------------- secrets
# 32+ characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Without this the API serves /v1/* unauthenticated -- the middleware skips
# authentication entirely when the token is empty.
MENO_API_TOKEN=replace-with-a-random-token-of-at-least-32-characters

# SiliconFlow API key for embeddings.
MENO_OPENAI_API_KEY=replace-with-siliconflow-api-key

# ------------------------------------------------------------------ embedding
MENO_EMBEDDING_PROVIDER=siliconflow
MENO_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
MENO_EMBEDDING_MODEL=BAAI/bge-m3
MENO_EMBEDDING_DIMENSION=1024
MENO_EMBEDDING_PROJECTION_VERSION=siliconflow-bge-m3-1024-v1
MENO_OPENAI_TIMEOUT_SECONDS=15
MENO_OPENAI_BATCH_SIZE=32
MENO_OPENAI_MAX_RETRIES=4
MENO_OPENAI_CIRCUIT_BREAKER_THRESHOLD=3
MENO_OPENAI_CIRCUIT_BREAKER_SECONDS=30

# --------------------------------------------------------------- memory bound
# Vectors held in the process. At 1024 dims each costs ~4.1 KB as array("f"):
#   20000 -> ~80 MB      50000 -> ~199 MB
# Past the cap, writes fail and /health/ready reports degraded rather than the
# process growing until the kernel kills it. Keep this consistent with
# MemoryMax= in meno.service.
MENO_VECTOR_MAX_RESIDENT=20000
MENO_VECTOR_UPSERT_BATCH_SIZE=128

# ------------------------------------------------------------------- listener
# Bind to loopback: Meno is a sidecar for a Hermes process on the same host.
# Exposing it beyond loopback puts a memory store on the network -- if you must,
# put a TLS-terminating reverse proxy in front and keep the token secret.
MENO_API_HOST=127.0.0.1
MENO_API_PORT=8765

# ------------------------------------------------------------------- features
# Defaults are off. The three below are required for #15 calibration pairing:
# without materialization there is no snapshot to pair feedback against.
MENO_USER_TOKEN_MATERIALIZATION_ENABLED=true
MENO_PREFERENCE_DISTRIBUTION_ENABLED=true
MENO_CONTEXT_ACTIVATION_ENABLED=true

# Deterministic reflection: derives `pattern` claims from repeated preferences.
MENO_REFLECTION_ENABLED=true

# Off by default. Enabling semantic routing in production also requires a pinned
# config SHA-256, which validate() enforces.
MENO_SEMANTIC_ROUTING_ENABLED=false
MENO_PREFERENCE_DISTRIBUTION_V2_ENABLED=false
MENO_CLARIFICATION_OPPORTUNITIES_ENABLED=false
MENO_LAYERED_RETRIEVAL_ENABLED=false
MENO_EVIDENCE_SELECTION_ENABLED=false
MENO_PREFERENCE_HISTORY_RETRIEVAL_ENABLED=false

# ------------------------------------------------------------------- workers
MENO_WORKER_POLL_SECONDS=0.2
MENO_OUTBOX_COMMIT_BATCH_SIZE=32
MENO_OUTBOX_RETRY_BASE_SECONDS=1
MENO_OUTBOX_RETRY_MAX_SECONDS=300
MENO_AUDIT_BUFFER_MAX=10000
